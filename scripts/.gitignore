# large source dumps (re-downloaded on demand)
geonames_*.zip
# derived candidate / cache / verified artifacts (regenerated by the pipeline).
# Region-suffixed too: every stage writes `<name>.<region>.json` (poi_geo.work).
auth_gap_candidates*.json
poi_auth_verified*.json
poi_auth_cache*.json
poi_gap_cache*.json
poi_bizstatus_cache*.json
poi_gap_verified*.json
auth_lists/

# consular directory PDF (re-downloaded on demand)
consular_directory.pdf
*DIPLOMATICOFFICES.pdf

# IMLS GLAMs ArcGIS dump (re-fetched on demand)
glams.json

# OSM footprint polygon dumps (re-fetched on demand by fetch_osm_polys.py)
osm_polys_*.json
osm_gap_candidates*.json
osm_gap_audit*.md
# local curated backups / one-off review dumps
poi_curated.bak*.json
poi_full_*.bak.json
poi_curated_primaryonly.bak.json
poi_full_curated.json
poi_full_review.md
poi_merge_viz.json

# WMATA rail GTFS (re-downloaded by build_dc_stations.py with a free API key)
wmata_rail_gtfs*
# Census TIGER place shapefile cache (re-downloaded on demand by build_play_area.py)
_census_place/
# Census national ZCTA shapefile cache (~530 MB, re-downloaded by build_region_geo.py)
_census_zcta/
# Census TIGER AREAWATER + OSM coastline shapefile cache (re-fetched on demand
# by build_water_mask.py / build_bay_land.py)
_cache/
# one-off scratch dump of county place names (not used by the pipeline)
_county_places.json
